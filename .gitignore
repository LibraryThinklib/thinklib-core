*.docx
LICENSE.meta

# docs/ ships without .meta files on purpose (it's plain documentation,
# not Unity assets) - don't let the Editor's auto-generated ones show up.
docs.meta
docs/*.meta

# This repo is a UPM package (com.thinklib.core). The folders below only
# exist when this directory is opened directly as a Unity project/sandbox
# for local testing - they are not part of the package.
/Assets/
/Library/
/Logs/
/Packages/
/ProjectSettings/
/UserSettings/
Assets.meta
Logs.meta
Packages.meta
ProjectSettings.meta
UserSettings.meta

# Standard Unity-generated cruft (in case the package is tested inside a
# full project elsewhere, or these ever reappear here)
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Autogenerated VS/Rider/MonoDevelop solution and project files
.vs/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for the above
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D crash report file
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties
